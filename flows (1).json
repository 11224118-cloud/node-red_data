    {
        "id": "da28698e064d44ec",
        "type": "function",
        "z": "f8a1b9eb23f2466b",
        "name": "解析發送者與訊息類別並分流",
        "func": "// Topic 格式預期為: AIOT/userX/message/category\nvar parts = msg.topic.split(\"/\");\nvar sender = parts[1] || \"未知用戶\";\nvar category = (parts[3] || \"other\").toLowerCase();\n\nvar timeStr = new Date().toLocaleTimeString('zh-TW', { hour12: false });\nvar formattedText = \"[\" + timeStr + \"] \" + sender + \"：\" + msg.payload;\n\nvar outAnnounce = null;\nvar outAlert = null;\nvar outStatus = null;\nvar outLatest = { payload: \"(\" + category.toUpperCase() + \") \" + formattedText };\n\nif (category === \"announcement\") {\n    outAnnounce = { payload: formattedText };\n} else if (category === \"alert\") {\n    outAlert = { payload: formattedText };\n} else if (category === \"status\") {\n    outStatus = { payload: formattedText };\n}\n\nreturn [outLatest, outAnnounce, outAlert, outStatus];",
        "outputs": 4,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
