    {
        "id": "5fbf2d0742f1f530",
        "type": "function",
        "z": "f8a1b9eb23f2466b",
        "name": "組合類別與內容並發送",
        "func": "if (msg.topic === \"selected_cat\") {\n    context.set(\"cat\", msg.payload);\n    return null;\n}\n\nif (msg.topic === \"msg_text\") {\n    var cat = context.get(\"cat\") || \"announcement\";\n    var text = String(msg.payload).trim();\n    if (!text) return null;\n    \n    msg.topic = \"AIOT/user7/message/\" + cat;\n    msg.payload = text;\n    return msg;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 210,
        "wires": [
