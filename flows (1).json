            ]
        ]
    },
    {
        "id": "7136ca36f7cb5afe",
        "type": "function",
        "z": "f8a1b9eb23f2466b",
        "name": "整理表單發送 Topic",
        "func": "var cat = String(msg.payload.category || \"announcement\").trim().toLowerCase();\nvar content = String(msg.payload.content || \"\").trim();\n\nif (!content) return null;\n\nmsg.topic = \"AIOT/user7/message/\" + cat;\nmsg.payload = content;\nreturn msg;",
        "outputs": 1,
